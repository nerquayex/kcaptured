### Example environment variables (do NOT commit real credentials)
# Copy this to `.env.local` and fill in real values locally.

# URL for your Postgres/Neon database. Example placeholder only — replace locally.
DATABASE_URL=postgresql://username:password@host:5432/dbname?sslmode=require

# Cloudinary and other existing variables (examples only)
NEXT_PUBLIC_FORMSPREE_ID=your_formspree_id
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
